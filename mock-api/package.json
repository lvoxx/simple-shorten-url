{
  "name": "url-shortener-mock-api",
  "version": "1.0.0",
  "description": "Mock API for URL Shortener using json-server",
  "main": "index.js",
  "scripts": {
    "start": "json-server --watch db.json --port 3000",
    "dev": "json-server --watch db.json --port 3000 --delay 500",
    "routes": "json-server --watch db.json --routes routes.json --port 3000",
    "readonly": "json-server --watch db.json --port 3000 --read-only"
  },
  "dependencies": {
    "json-server": "^1.0.0-beta.15"
  }
}